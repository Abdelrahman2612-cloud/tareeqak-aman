rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بلاغات الطريق
    match /reports/{reportId} {
      // القراءة للكل: الخريطة والتتبع والإحصائيات شغالة من غير تسجيل دخول
      allow read: if true;

      // الإنشاء للكل: أي حد يقدر يبلّغ عن مشكلة، حتى كضيف
      allow create: if true;

      // التعديل والحذف للمشرفين المسجلين بس (Firebase Auth)
      // كده حد يقدر يغيّر حالة بلاغ أو يمسحه إلا لو مسجل دخوله
      allow update, delete: if request.auth != null;
    }
  }
}
